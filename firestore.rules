rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo entra la cuenta de la cafetería (la misma para todo el equipo).
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email == "velezartisan@gmail.com";
    }
  }
}
